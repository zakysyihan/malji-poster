#!/bin/bash
for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.sources /etc/apt/sources.list.d/*.list; do
  [ -f "$f" ] || continue
  sed -i 's|deb.debian.org/debian-security|archive.debian.org/debian-security|g' "$f"
  sed -i 's|security.debian.org|archive.debian.org|g' "$f"
  sed -i '/bullseye-security/s/^/#/' "$f"
  sed -i '/Acquire::Check-Valid-Until/d' "$f"
done
echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99no-check-valid
apt-get update
apt-get install -y --no-install-recommends libgbm1 libnss3 libxss1 libasound2 libatk-bridge2.0-0 libgtk-3-0 libglib2.0-0 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxrandr2 libgbm-dev libpango-1.0-0 libcairo2 libatspi2.0-0
